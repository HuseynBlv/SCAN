# Copy this file to .env.neon for local Neon-backed development.
# .env.neon is ignored by Git. Never commit real passwords.

# SCAN API Basic Auth credentials (not Neon account/database credentials).
SCAN_ADMIN_USERNAME=scan-admin
SCAN_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
SCAN_CCI_USERNAME=scan-cci
SCAN_CCI_PASSWORD=replace-with-a-strong-local-cci-password
SCAN_INGEST_USERNAME=scan-connector
SCAN_INGEST_PASSWORD=replace-with-a-strong-connector-password
SCAN_RETAILER_USERNAME=scan-retailer
SCAN_RETAILER_PASSWORD=replace-with-a-strong-retailer-password
SCAN_ONBOARDING_USERNAME=scan-onboarding
SCAN_ONBOARDING_PASSWORD=replace-with-a-strong-onboarding-password

# On startup these accounts are created once in scan_account. Later credential rotation and
# revocation are database-managed and survive restarts. Their retailer/profile binding is immutable.
# ADMIN, INGEST, and RETAILER are bound to this retailer; ADMIN and INGEST also use this profile.
SCAN_PILOT_RETAILER_CODE=DEMO
SCAN_PILOT_PROFILE_CODE=CANONICAL
SCAN_ACCOUNT_BOOTSTRAP_ENABLED=true
SCAN_RUNTIME_ENVIRONMENT=development
SCAN_DATABASE_ID=scan-local-development

# Non-secret Neon target used by scripts/run-neon-api.sh.
SCAN_NEON_PROJECT_ID=withered-darkness-12839995
SCAN_NEON_BRANCH=production
SCAN_NEON_ROLE=scan_app
SCAN_NEON_DATABASE=scan
