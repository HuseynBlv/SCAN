# Copy this file to .env.neon for local Neon-backed development.
# .env.neon is ignored by Git. Never commit real passwords.

# SCAN API Basic Auth credentials (not Neon account/database credentials).
SCAN_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
SCAN_CCI_PASSWORD=replace-with-a-strong-local-cci-password
SCAN_INGEST_PASSWORD=replace-with-a-strong-connector-password
SCAN_RETAILER_PASSWORD=replace-with-a-strong-retailer-password

# The first pilot connector and retailer account are bound to this retailer/profile.
SCAN_PILOT_RETAILER_CODE=KAGGLE
SCAN_PILOT_PROFILE_CODE=KAGGLE_2019

# Non-secret Neon target used by scripts/run-neon-api.sh.
SCAN_NEON_PROJECT_ID=withered-darkness-12839995
SCAN_NEON_BRANCH=production
SCAN_NEON_ROLE=scan_app
SCAN_NEON_DATABASE=scan
